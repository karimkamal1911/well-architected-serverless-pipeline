{
  "Comment": "Serverless Image Processing Workflow",
  "StartAt": "Validate",
  "States": {
    "Validate": {
      "Type": "Task",
      "Resource": "${ValidateFunctionArn}",
      "Retry": [
        {
          "ErrorEquals": ["States.TaskFailed"],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2.0
        }
      ],
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "Next": "PublishFailureMessage"
        }
      ],
      "Next": "Resize"
    },
    "Resize": {
      "Type": "Task",
      "Resource": "${ResizeFunctionArn}",
      "Retry": [
        {
          "ErrorEquals": ["States.TaskFailed"],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2.0
        }
      ],
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "Next": "PublishFailureMessage"
        }
      ],
      "Next": "Watermark"
    },
    "Watermark": {
      "Type": "Task",
      "Resource": "${WatermarkFunctionArn}",
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "Next": "PublishFailureMessage"
        }
      ],
      "Next": "ExtractMetadata"
    },
    "ExtractMetadata": {
      "Type": "Task",
      "Resource": "${ExtractMetadataFunctionArn}",
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "Next": "PublishFailureMessage"
        }
      ],
      "Next": "Store"
    },
    "Store": {
      "Type": "Task",
      "Resource": "${StoreFunctionArn}",
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "Next": "PublishFailureMessage"
        }
      ],
      "End": true
    },
    "PublishFailureMessage": {
      "Type": "Task",
      "Resource": "arn:aws:states:::sns:publish",
      "Parameters": {
        "TopicArn": "${SNSTopicArn}",
        "Message.$": "$"
      },
      "Next": "ProcessingFailed"
    },
    "ProcessingFailed": {
      "Type": "Fail",
      "Error": "ProcessingFailed",
      "Cause": "The image processing workflow failed. Check SNS notification and CloudWatch logs."
    }
  }
}
